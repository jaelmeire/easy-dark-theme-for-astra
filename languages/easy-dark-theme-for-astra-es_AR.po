msgstr "Mejora el contorno de foco del botón al navegar con Tab."

#: includes/class-edta-admin.php:20
msgid ""
"In Button mode, remembers the user's chosen theme to keep it between visits."
msgstr ""
"En modo Botón, recuerda el tema elegido por el usuario para mantenerlo entre "
"visitas."

#: includes/class-edta-admin.php:242
msgid "Incorrect confirmation. Reset was not applied."
msgstr "Confirmación incorrecta. No se aplicó el restablecimiento."

